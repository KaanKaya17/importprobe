{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.KaanKaya17/importprobe",
  "title": "importprobe",
  "description": "Look up a package's real API, vet packages before install, catch made-up imports.",
  "repository": {
    "url": "https://github.com/KaanKaya17/importprobe",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "importprobe",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
